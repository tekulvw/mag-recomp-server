<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CS8892: a second synchronous Main would silently replace Program.Main as the entry point. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8892</WarningsAsErrors>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Server.Dme/Server.Dme.csproj" />
    <PackageReference Include="DotNetty.Handlers" Version="0.7.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="NReco.Logging.File" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HighResolutionTimer\HighResolutionTimer.csproj" />
    <ProjectReference Include="..\RT.Common\RT.Common.csproj" />
    <ProjectReference Include="..\RT.Cryptography\RT.Cryptography.csproj" />
    <ProjectReference Include="..\RT.Models\RT.Models.csproj" />
    <ProjectReference Include="..\Server.Pipeline\Server.Pipeline.csproj" />
    <ProjectReference Include="..\Server.Common\Server.Common.csproj" />
    <ProjectReference Include="..\Server.Database\Server.Database.csproj" />
    <ProjectReference Include="..\Server.Plugins\Server.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release Please creates the component changelog on its first component release. -->
    <EmbeddedResource Include="../CHANGELOG.md" Condition="Exists('../CHANGELOG.md')" LogicalName="MagServerNews.MediusChangelog" />
  </ItemGroup>

</Project>
