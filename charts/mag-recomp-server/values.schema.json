{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "medius": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        },
        "gameplay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        },
        "awsCli": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "advertisedIPv4": {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "authDns": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.-]*$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "enum": [
            "Cluster",
            "Local"
          ]
        },
        "mapsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": {
            "enum": [
              10475,
              10478,
              10477,
              10472,
              10476,
              10473
            ]
          }
        },
        "dmeHumanCapacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 256
        },
        "udpPortRange": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "const": 10474
            },
            "end": {
              "type": "integer",
              "minimum": 10474,
              "maximum": 10729
            }
          },
          "required": [
            "start",
            "end"
          ]
        }
      },
      "required": [
        "advertisedIPv4",
        "authDns"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "applicationId": {
          "enum": [
            20230,
            20231
          ]
        },
        "protocolVersion": {
          "type": "integer",
          "minimum": 1
        },
        "gameType": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "minimumPlayers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maximumPlayers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "startingLevel": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 255}]},
        "trainingLevel": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 255}]},
        "initialSpawnDelayMs": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 120000},
            {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 120000}, "minItems": 2, "maxItems": 2}
          ]
        }
      },
      "required": [
        "existingSecret"
      ]
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "existingClaim",
            "s3"
          ]
        },
        "existingClaim": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "emptyDirSizeLimit": {
          "type": "string",
          "minLength": 1
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^$|^https?://[^\\s]+$"
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "bucket": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "versionId": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "forcePathStyle": {
              "type": "boolean"
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "spawns": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "wireProfiles": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "skills": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "loadoutDefaults": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "developmentProgression": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "trainingCompletion": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
                  "not": {
                    "pattern": "(^|/)\\.\\.(/|$)"
                  }
                },
                {
                  "const": ""
                }
              ]
            },
            "progression": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
                  "not": {
                    "pattern": "(^|/)\\.\\.(/|$)"
                  }
                },
                {
                  "const": ""
                }
              ]
            },
            "retailSkills": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "retailArmory": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "characterBlastRules": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "bootstrapLoadouts": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "retailCombatMetadata": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "fallDamageRules": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "botNames": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
                  "not": {
                    "pattern": "(^|/)\\.\\.(/|$)"
                  }
                },
                {
                  "const": ""
                }
              ]
            }
          }
        },
        "gameplayExtraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "s3"
              }
            }
          },
          "then": {
            "properties": {
              "s3": {
                "required": [
                  "bucket",
                  "key",
                  "sha256",
                  "existingSecret"
                ],
                "properties": {
                  "bucket": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "existingClaim"
              }
            }
          },
          "then": {
            "properties": {
              "existingClaim": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "gameplayWorkers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
              },
              {
                "const": ""
              }
            ]
          },
          "matchProfiles": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$",
            "not": {
              "pattern": "(^|/)\\.\\.(/|$)"
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "revision": {
                "type": "string"
              },
              "s3": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "pattern": "^$|^https?://[^\\s]+$"
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bucket": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "versionId": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "existingSecret": {
                    "type": "string"
                  },
                  "forcePathStyle": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "key",
                  "sha256"
                ]
              },
              "files": {
                "$ref": "#/properties/data/properties/files"
              }
            },
            "required": [
              "s3"
            ]
          },
          "emptyDirSizeLimit": {
            "type": "string",
            "minLength": 1
          },
          "navigation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "revision": {
                "type": "string"
              },
              "s3": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "pattern": "^$|^https?://[^\\s]+$"
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bucket": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "versionId": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "existingSecret": {
                    "type": "string"
                  },
                  "forcePathStyle": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "key",
                  "sha256"
                ]
              },
              "emptyDirSizeLimit": {
                "type": "string",
                "minLength": 1
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$",
                "not": {
                  "pattern": "^/(data|logs|tmp|download|work|catalogs|scripts|proc|sys|dev|etc|usr|bin|lib|run)(/|$)"
                }
              }
            },
            "required": [
              "s3"
            ]
          },
          "extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minimumPlayers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "maximumPlayers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "minimumPlayersPerTeam": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "minItems": 2,
            "maxItems": 2
          },
          "draining": {
            "type": "boolean"
          },
          "resources": {
            "type": "object"
          },
          "nodeSelector": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tolerations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "affinity": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "matchProfiles",
          "data"
        ]
      }
    },
    "worldRegistry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partyInviteSeconds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          ]
        },
        "workerWaitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "workerRestartAdoption": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxAdoptions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "windowSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameplay": {
          "type": "object"
        },
        "medius": {
          "type": "object"
        },
        "maps": {
          "type": "object"
        },
        "init": {
          "type": "object"
        }
      }
    },
    "portalTickets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["off", "required"]},
        "audience": {"type": "string", "pattern": "^([a-z0-9.-]{1,63})?$"},
        "keys": {
          "type": "object",
          "propertyNames": {"pattern": "^(0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 255}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "required"}}, "required": ["mode"]},
          "then": {
            "required": ["audience", "keys"],
            "properties": {"audience": {"minLength": 1}, "keys": {"minProperties": 1}}
          }
        }
      ]
    },
    "adminApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "not": {"enum": [10073, 10471, 10472, 10474, 10475, 10476, 10477, 10478]}
        },
        "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"},
        "secretKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[-._a-zA-Z0-9]+$"},
        "allowedNamespaceSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {"type": "object", "additionalProperties": {"type": "string"}},
            "matchExpressions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "operator"],
                "properties": {
                  "key": {"type": "string", "minLength": 1},
                  "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
                  "values": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "required": ["existingSecret", "allowedNamespaceSelector"],
            "properties": {
              "existingSecret": {"minLength": 1},
              "allowedNamespaceSelector": {
                "anyOf": [
                  {"required": ["matchLabels"], "properties": {"matchLabels": {"minProperties": 1}}},
                  {"required": ["matchExpressions"], "properties": {"matchExpressions": {"minItems": 1}}}
                ]
              }
            }
          }
        }
      ]
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "segmentBytes": {
              "type": ["integer", "null"],
              "minimum": 65536
            },
            "retentionSeconds": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        },
        "answerIPv4": {
          "type": "string"
        },
        "hostnames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+\\.?$"
          }
        },
        "upstreams": {
          "type": "array",
          "minItems": 1,
